{
  "appId": "kr.classserver.student",
  "productName": "ClassServer-Student",
  "extraMetadata": {
    "name": "class-server-student",
    "main": "student-client/src/main.js"
  },
  "directories": {
    "output": "release/student"
  },
  "files": [
    "package.json",
    "student-client/src/**/*",
    "shared/**/*",
    "!**/node_modules/.cache/**"
  ],
  "win": {
    "target": [
      "portable"
    ],
    "signingHashAlgorithms": [
      "sha256"
    ],
    "rfc3161TimeStampServer": "http://timestamp.digicert.com",
    "verifyUpdateCodeSignature": false
  },
  "portable": {
    "artifactName": "ClassServer-학생용-${version}.exe"
  }
}
