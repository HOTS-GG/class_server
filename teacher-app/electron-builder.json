{
  "appId": "kr.classserver.teacher",
  "productName": "ClassServer-Teacher",
  "extraMetadata": {
    "name": "class-server-teacher",
    "main": "teacher-app/src/main.js"
  },
  "directories": {
    "output": "release/teacher"
  },
  "files": [
    "package.json",
    "teacher-app/src/**/*",
    "server/**/*",
    "shared/**/*",
    "!**/node_modules/.cache/**"
  ],
  "win": {
    "target": [
      "nsis"
    ],
    "signingHashAlgorithms": [
      "sha256"
    ],
    "rfc3161TimeStampServer": "http://timestamp.digicert.com",
    "verifyUpdateCodeSignature": false
  },
  "fileAssociations": [
    {
      "ext": "classdb",
      "name": "교실 평가 세이브",
      "description": "교실 평가 시스템 세이브 파일",
      "role": "Editor"
    }
  ],
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "artifactName": "ClassServer-교사용-Setup-${version}.exe",
    "shortcutName": "교실 평가 시스템 (교사용)"
  }
}
