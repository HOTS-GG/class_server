{
  "name": "class-server",
  "version": "0.2.0",
  "private": true,
  "description": "교실 평가 시스템 — 교사 호스트 + 학생 클라이언트 (과제 배부/회수, CBT, AI 서술형 채점, 붙여넣기 차단)",
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "teacher-app",
    "student-client"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "smoke": "node tools/smoke.js",
    "server": "node server/src/standalone.js",
    "teacher": "node tools/launch-electron.js teacher-app/src/main.js",
    "student": "node tools/launch-electron.js student-client/src/main.js --dev",
    "simulate": "node tools/simulate.js",
    "build:teacher": "electron-builder --config teacher-app/electron-builder.json",
    "build:student": "electron-builder --config student-client/electron-builder.json"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "express": "^4.19.2",
    "lowdb": "^7.0.1",
    "multer": "^1.4.5-lts.1",
    "socket.io": "^4.7.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "socket.io-client": "^4.7.5"
  }
}
